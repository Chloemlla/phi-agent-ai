# ─────────────────────────────────────────────────────────────
# Whitelist mode: ignore everything by default and opt in only the
# files that belong in version control. When adding a new top-level
# file or directory, add a matching ! rule here.
# ─────────────────────────────────────────────────────────────
/*

# Repository metadata
!/.gitignore
!/.gitattributes
!/bunfig.toml
!/eslint.config.js
!/.prettierrc.json
!/.prettierignore
!/AGENT.md
!/CLAUDE.md
!/.github/
!/.github/**
!/LICENSE
!/README.md
!/README.zh-CN.md
!/CONTRIBUTING.md
!/SECURITY.md
!/assets/
!/assets/**
!/docs/
!/docs/**

# Frontend
!/package.json
!/bun.lock
!/index.html
!/tsconfig.json
!/tsconfig.node.json
!/vite.config.ts
!/scripts/
!/scripts/**
!/src/
!/src/**
!/tests/
!/tests/**
!/public/
!/public/**

# Desktop core
!/src-tauri/
!/src-tauri/**

# Local runtime data (journal, blobs, providers, memory) must never be
# committed, even though the shell directories are whitelisted above.
/.phi/
/src-tauri/.phi/

# The Lumen Crash SDK artifacts are staged here from a GitHub release by
# `node scripts/fetch-lumen-crash.mjs`. They are build inputs, not sources: the
# version pin in gradle.properties plus that script reproduce them exactly.
/src-tauri/gen/android/lumen-crash-maven/
