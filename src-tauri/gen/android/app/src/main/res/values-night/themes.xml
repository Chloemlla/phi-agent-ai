<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- v1 has no dark theme: force the light palette even when the system is
         in night mode, otherwise the status bar icons become unreadable. -->
    <style name="Theme.phi_agent" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- The launcher gate renders nothing; it only routes. Activities with
         NoDisplay must finish inside onCreate, which the gate does. -->
    <style name="Theme.phi_agent.Gate" parent="android:Theme.NoDisplay" />
</resources>
